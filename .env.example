# Required
WATCHDOG_USERNAME=admin
WATCHDOG_PASSWORD=password(changeme-in-prod)

# Container collection (optional)
APIWATCH_COLLECT_LABEL=apiwatch.collect=true
APIWATCH_WATCH_ALL=false
APIWATCH_EXCLUDE=test-app,financing_app

# Log storage (optional)
APIWATCH_LOG_LEVELS=INFO,DEBUG,CRITICAL,ERROR,WARNING
APIWATCH_RETENTION_HOURS=72
APIWATCH_SESSION_TTL_SECONDS=86400

# Slack alerts (optional)
APIWATCH_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook

# Gmail alerts (optional)
APIWATCH_GMAIL_USER=your-email@gmail.com
APIWATCH_GMAIL_APP_PASSWORD=your-app-password
APIWATCH_ALERT_EMAIL_TO=your-email@gmail.com

# Alert settings (optional)
APIWATCH_ALERT_COOLDOWN_SECONDS=300(seconds)
APIWATCH_PUBLIC_URL=https://logs.example.com